Subject: [PATCH] ReSukiSU: SUSFS-X compatibility for current supercall layout

Adapt the former ReSukiSU SUSFS integration to the current split
kernel/supercall/dispatch.c layout used by ReSukiSU. Keep process-mark
updates tied to both the tracepoint hook and SUSFS, and expose the
SUSFS-X KSTAT redirect command when the corresponding SUSFS feature is
enabled.

diff -ruN a/kernel/supercall/dispatch.c b/kernel/supercall/dispatch.c
--- a/kernel/supercall/dispatch.c	2026-08-28 00:00:00.000000000 +0000
+++ b/kernel/supercall/dispatch.c	2026-08-28 00:00:00.000000000 +0000
@@ -393,7 +393,7 @@
     ret = ksu_set_app_profile(&cmd.profile);
     if (!ret) {
         ksu_persistent_allow_list();
-#ifdef CONFIG_KSU_TRACEPOINT_HOOK
+#if defined(CONFIG_KSU_TRACEPOINT_HOOK) && defined(CONFIG_KSU_SUSFS)
         ksu_mark_running_process();
 #endif
     }
@@ -960,6 +960,12 @@
     case CMD_SUSFS_ADD_SUS_KSTAT_STATICALLY: {
         susfs_add_sus_kstat(arg);
         return 0;
     }
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT_REDIRECT
+    case CMD_SUSFS_ADD_SUS_KSTAT_REDIRECT: {
+        susfs_add_sus_kstat_redirect(arg);
+        return 0;
+    }
+#endif
 #endif //#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
 #ifdef CONFIG_KSU_SUSFS_SPOOF_UNAME
*** End Patch
