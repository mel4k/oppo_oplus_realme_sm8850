From 0000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] 70: detect ReSukiSU layout instead of fixed supercalls.c

--- a/scripts/apply_resukisu.sh
+++ b/scripts/apply_resukisu.sh
@@
-SEARCH_FILE="common/drivers/kernelsu/supercalls.c"
+SEARCH_FILE="$(find common/drivers/kernelsu -type f \
+  \( -name 'supercalls.c' -o -name 'hook.c' -o -name 'ksu.c' \) \
+  | head -n 1)"

-if [ ! -f "$SEARCH_FILE" ]; then
+if [ -z "$SEARCH_FILE" ] || [ ! -f "$SEARCH_FILE" ]; then
     echo "[ERROR] ReSukiSU entry not found"
     exit 1
 fi
